APP_NAME="Budimas Accounting"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Dedicated MySQL Accounting database. Configure these, then set
# DB_CONNECTION=accounting_mysql before running migrations in MySQL.
# ACCOUNTING_DATABASE_CONNECTION=accounting_mysql
# ACCOUNTING_MYSQL_HOST=127.0.0.1
# ACCOUNTING_MYSQL_PORT=3306
# ACCOUNTING_MYSQL_DATABASE=budimas_accounting
# ACCOUNTING_MYSQL_USERNAME=
# ACCOUNTING_MYSQL_PASSWORD=
# ACCOUNTING_MYSQL_SOCKET=
# ACCOUNTING_MYSQL_ATTR_SSL_CA=
# ACCOUNTING_MYSQL_STRICT=true

# Local-only initial login. Leave unset for shared or production environments.
# ACCOUNTING_LOCAL_ADMIN_NAME="Local Accounting Admin"
# ACCOUNTING_LOCAL_ADMIN_EMAIL=admin@accounting.local
# ACCOUNTING_LOCAL_ADMIN_PASSWORD=

# Optional PostgreSQL Accounting connection retained for migration/testing.
# DB_CONNECTION=accounting_pgsql
# ACCOUNTING_POSTGRES_HOST=127.0.0.1
# ACCOUNTING_POSTGRES_PORT=5434
# ACCOUNTING_POSTGRES_DATABASE=budimas_accounting
# ACCOUNTING_POSTGRES_USER=
# ACCOUNTING_POSTGRES_PASSWORD=

# Read-only ERP source through an SSH tunnel; never use a production writer.
# ERP_POSTGRES_HOST=127.0.0.1
# ERP_POSTGRES_PORT=15432
# ERP_POSTGRES_DATABASE=
# ERP_POSTGRES_USER=
# ERP_POSTGRES_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
